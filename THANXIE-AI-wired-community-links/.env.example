NODE_ENV=production
PORT=3000
DATABASE_PATH=./data/thanxie.sqlite

# Meta WhatsApp Business Platform
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Official Meta phone-number onboarding
# This flow registers an eligible WhatsApp Business number already present in the WABA.
# It does NOT pair personal WhatsApp accounts and does NOT use QR/WhatsApp-Web sessions.
PHONE_PAIRING_ENABLED=false
PAIRING_ADMIN_TOKEN=

# Groups API
META_GROUPS_API_ENABLED=true
META_GROUP_JOIN_APPROVAL_ENABLED=true
META_GROUP_MENTIONS_ENABLED=true
REGISTRATION_GROUP_ID=
REGISTRATION_GROUP_LINK=

# Bot identity / community
BOT_NAME=THANXIE AI
OWNER_WHATSAPP_ID=
DEVELOPER_NAME=THANXIE
DEVELOPER_PHONE=
WHATSAPP_CHANNEL_URL=
WHATSAPP_GROUP_URL=
SUPPORT_URL=

# Optional AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
