NODE_ENV=production
PORT=3000
DATABASE_PATH=./data/thanxie.sqlite

# Personal WhatsApp Web-style transport (Baileys)
BAILEYS_AUTH_DIR=./data/baileys-auth
BAILEYS_PAIRING_NUMBER=
BAILEYS_LOG_LEVEL=warn
PAIRING_ADMIN_TOKEN=

# Conservative outbound policy
WA_GLOBAL_MESSAGES_PER_MINUTE=30
WA_GROUP_MESSAGES_PER_MINUTE=10
WA_USER_MESSAGES_PER_MINUTE=6
WA_MIN_SEND_DELAY_MS=1800
WA_DUPLICATE_WINDOW_MS=120000
WA_MAX_QUEUE=100
WA_CIRCUIT_BREAK_MS=60000

# Bot identity / community
BOT_NAME=THANXIE AI
OWNER_WHATSAPP_ID=
DEVELOPER_NAME=THANXIE
DEVELOPER_PHONE=
WHATSAPP_CHANNEL_URL=
WHATSAPP_GROUP_URL=
SUPPORT_URL=
REGISTRATION_GROUP_ID=
REGISTRATION_GROUP_LINK=

# Legacy Meta settings retained for modules that still provide data/services.
# The active WhatsApp transport on this branch is Baileys.
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GROUPS_API_ENABLED=false
META_GROUP_JOIN_APPROVAL_ENABLED=false
META_GROUP_MENTIONS_ENABLED=false

# Optional AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
