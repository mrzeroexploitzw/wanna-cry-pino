{
  "name": "thanxie-ai",
  "version": "3.0.0",
  "description": "THANXIE AI — personal WhatsApp group-management bot with conservative transport safeguards.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/app.js",
    "dev": "node --env-file-if-exists=.env --watch src/app.js",
    "test": "node --test",
    "check": "node --check src/app.js && node --check src/handlers/webhook.js && node --check src/handlers/messages.js && node --check src/services/whatsapp/baileysClient.js && node --check src/services/whatsapp/behaviorGuard.js && node --check src/services/commands/commandService.js && node --check src/services/meta/metaClient.js && node --check src/services/meta/groupClient.js && node --check src/services/community/groupStatsService.js
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "@whiskeysockets/baileys": "^7.0.0-rc.14",
    "pino": "^9.6.0",
    "sharp": "^0.34.3"
  }
}
